# --- Base de Datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medical_db
DB_USER=medical_user
DB_PASSWORD=medical_pass

# --- Backend (Spring Boot) ---
JWT_SECRET=cambia_esto_por_una_clave_segura_de_minimo_32_caracteres
JWT_EXPIRATION_MS=86400000
SPRING_PROFILES_ACTIVE=dev

# --- Frontend (React) ---
REACT_APP_API_URL=http://localhost:8080/api

