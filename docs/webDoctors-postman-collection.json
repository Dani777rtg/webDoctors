            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"paciente_test@correo.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Juan\",\n  \"lastName\": \"Perez\",\n  \"phone\": \"3001234567\"\n}"
