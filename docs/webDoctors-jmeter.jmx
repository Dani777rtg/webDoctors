            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PATIENT_PASS" elementType="Argument">
            <stringProp name="Argument.name">PATIENT_PASS</stringProp>
            <stringProp name="Argument.value">Password123!</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DOCTOR_EMAIL" elementType="Argument">
            <stringProp name="Argument.name">DOCTOR_EMAIL</stringProp>
            <stringProp name="Argument.value">dr.garcia@medical.com</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DOCTOR_PASS" elementType="Argument">
            <stringProp name="Argument.name">DOCTOR_PASS</stringProp>
            <stringProp name="Argument.value">Password123!</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ADMIN_EMAIL" elementType="Argument">
            <stringProp name="Argument.name">ADMIN_EMAIL</stringProp>
            <stringProp name="Argument.value">admin@medical.com</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="ADMIN_PASS" elementType="Argument">
            <stringProp name="Argument.name">ADMIN_PASS</stringProp>
            <stringProp name="Argument.value">Password123!</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
